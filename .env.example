# ==============================================================================
# RoomAI Environment Configuration Template
# ==============================================================================

# Application & API Server Settings
ROOMAI_ENV=production
ROOMAI_API_HOST=0.0.0.0
ROOMAI_API_PORT=8000
ROOMAI_LOG_LEVEL=INFO

# Frontend Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# GPU & Hardware Settings
CUDA_VISIBLE_DEVICES=0
MAX_CONCURRENT_GPU_OPS=1
MIN_FREE_VRAM_MB=1500

# Storage & Retention Settings
ARTIFACTS_DIR=artifacts
MAX_STORAGE_MB=500
UPLOAD_MAX_SIZE_MB=20
MAX_IMAGE_PIXELS=100000000

# Model Checkpoints (Relative to repository root)
ROOMAI_MODEL_URL=https://huggingface.co/Apaarag/roomai-a3-indoor-detector/resolve/main/indoor_detector_a3_yolo11s_800px_best.pt?download=true
ROOMAI_MODEL_SHA256=6CBC9E58F87156E07DD0E4E712B8AA96097AEB514A473621139A54CB83CEC576
ROOMAI_MODEL_PATH=checkpoints/indoor_detector_a3_yolo11s_800px_best.pt
INDOOR_DETECTOR_CHECKPOINT=checkpoints/indoor_detector_a3_yolo11s_800px_best.pt
EXTERIOR_DETECTOR_CHECKPOINT=checkpoints/exterior_detector_b2_yolo11s_best.pt
PARKING_DETECTOR_CHECKPOINT=checkpoints/parking_detector_c2_yolo11s_pilot_best.pt
SEGMENTATION_CHECKPOINT=checkpoints/yolo11n-seg.pt
METRIC_DEPTH_CHECKPOINT=checkpoints/depth_anything_v2_metric_indoor_small
RELATIVE_DEPTH_CHECKPOINT=checkpoints/depth_anything_v2_small

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

