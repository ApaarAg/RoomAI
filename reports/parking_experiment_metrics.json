  "experiment_d_capacity_analysis": {
    "target_model": "YOLO11m (20.1M params)",
    "feasibility_assessment": "COUNTERPRODUCTIVE_DUE_TO_DATA_CONSTRAINT",
    "rationale": "The canonical parking training split contains only 510 images. Scaling from YOLO11s (9.4M) to YOLO11m (20.1M) doubles parameter count without increasing training support, which guarantees severe training memorization and validation overfit. Empirical evidence from C3 demonstrates that algorithmic class rebalancing (RFS) unlocked +7.92% test mAP50 and +11.12% recall within YOLO11s capacity while preserving real-time latency (25.6 ms) and low VRAM footprint (220 MB)."
  },
  "acceptance_decision": {
    "recommendation": "PROMOTE_CANDIDATE_C3_AS_NEW_PRIMARY_PARKING_DETECTOR",
    "rationale": "Candidate C3 achieved a substantial breakthrough on the held-out test split: test mAP50 improved by +0.0792 (+31.0% relative, from 0.2551 to 0.3343), test recall improved by +0.1112 (+42.1% relative, from 0.2640 to 0.3752), and test F1 improved from 0.3543 to 0.3950. Critically, bicycle test recall soared from 0.0000 to 0.5714 (mAP50 0.0657 -> 0.4871), tree test recall broke through 0.0000 to 0.0909, and outdoor_fixture recall rose from 0.2857 to 0.4286. Baseline checkpoints C1 and C2 remain preserved intact."
  }
