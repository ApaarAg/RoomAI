# RoomAI Web Application Environment Variables

# Hugging Face ZeroGPU Model A3 Inference Space (Production URL)
# Public Space: https://huggingface.co/spaces/Apaarag/roomai-a3-inference
# Set to 'local' to force all requests to the local FastAPI backend.
NEXT_PUBLIC_ROOMAI_INFERENCE_URL=https://Apaarag-roomai-a3-inference.hf.space

# Base URL for RoomAI FastAPI backend (default: local development port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Request Timeout in milliseconds (default: 60000 to accommodate ZeroGPU cold starts)
NEXT_PUBLIC_API_TIMEOUT_MS=60000

# Optional Hugging Face Token for elevated ZeroGPU quota in automated/server environments
# NEVER expose private tokens in client-side bundles (do not prefix with NEXT_PUBLIC_).
# HF_TOKEN=
